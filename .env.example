# Port & Environment
PORT=3000
NODE_ENV=development
DISABLE_HMR=true

# Firebase (optional client-side overrides)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIRESTORE_DATABASE_ID=

# ImgBB (Server-side ONLY - do not expose key to client)
IMGBB_API_KEY=

# Razorpay Payment Gateway (Server-side ONLY - do not expose secret to client)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
